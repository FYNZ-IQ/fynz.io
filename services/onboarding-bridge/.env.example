# GHL agency Private Integration Token.
# Scopes: locations (r/w), locations/customValues (r/w), contacts (write), oauth.
GHL_AGENCY_TOKEN=

# Agency (company) ID from GHL Settings -> Company.
GHL_COMPANY_ID=

# Shared secret; must match the value sent by the GHL Custom Webhook action.
WEBHOOK_SECRET=

# Optional: origins allowed to call POST /onboard/web (the website's
# onboarding wizard). Comma-separated. Leave empty to disable that endpoint.
PUBLIC_SITE_ORIGINS=https://fynz.io,https://www.fynz.io

# Optional: URL that receives failure/gap alerts as {"text": "..."} POSTs
# (e.g. a Slack incoming webhook). Alerts fall back to logs if unset.
ALERT_WEBHOOK_URL=

# Optional, defaults to 3000.
PORT=3000
